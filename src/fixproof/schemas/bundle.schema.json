{
  "$defs": {
    "AssetRecord": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "discriminator": {
            "mapping": {
              "build": "#/$defs/BuildAsset",
              "image": "#/$defs/ImageAsset",
              "workload": "#/$defs/WorkloadAsset"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ImageAsset"
            },
            {
              "$ref": "#/$defs/WorkloadAsset"
            },
            {
              "$ref": "#/$defs/BuildAsset"
            }
          ],
          "title": "Asset"
        },
        "index": {
          "minimum": 1,
          "title": "Index",
          "type": "integer"
        },
        "not_checked": {
          "description": "Platforms of the image index that were not checked, and why.",
          "items": {
            "$ref": "#/$defs/NotChecked"
          },
          "title": "Not Checked",
          "type": "array"
        },
        "platforms": {
          "description": "Every platform checked (ADR-0014); empty when the image was not read.",
          "items": {
            "$ref": "#/$defs/PlatformRecord"
          },
          "title": "Platforms",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "index",
        "asset",
        "verdict",
        "reason",
        "platforms",
        "not_checked"
      ],
      "title": "AssetRecord",
      "type": "object"
    },
    "BuildAsset": {
      "additionalProperties": false,
      "description": "An image a CI job has just built, read where it was built (ADR-0012 item 2).\n\n`source` is the tool argument as given: `docker:NAME[:TAG]` (the local Docker daemon),\n`docker-archive:PATH` or `oci-archive:PATH`. It has no registry digest yet, so `image` is\nalways None; what the tools read is recorded with each result.",
      "properties": {
        "image": {
          "default": null,
          "title": "Image",
          "type": "null"
        },
        "kind": {
          "const": "build",
          "default": "build",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "BuildAsset",
      "type": "object"
    },
    "ImageAsset": {
      "additionalProperties": false,
      "description": "An image named in scope.yaml.",
      "properties": {
        "image": {
          "$ref": "#/$defs/ImageRef"
        },
        "kind": {
          "const": "image",
          "default": "image",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "image"
      ],
      "title": "ImageAsset",
      "type": "object"
    },
    "ImageRef": {
      "additionalProperties": false,
      "description": "An image by registry, repository and digest. Tags are never part of the identity.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "registry": {
          "pattern": "^([a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9-]*[a-zA-Z0-9])(\\.([a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9-]*[a-zA-Z0-9]))*(:[0-9]+)?$",
          "title": "Registry",
          "type": "string"
        },
        "repository": {
          "pattern": "^[a-z0-9]+((\\.|_|__|-+)[a-z0-9]+)*(\\/[a-z0-9]+((\\.|_|__|-+)[a-z0-9]+)*)*$",
          "title": "Repository",
          "type": "string"
        }
      },
      "required": [
        "registry",
        "repository",
        "digest"
      ],
      "title": "ImageRef",
      "type": "object"
    },
    "Inputs": {
      "additionalProperties": false,
      "properties": {
        "fix_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Fix Sha256",
          "type": "string"
        },
        "scope_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Scope Sha256",
          "type": "string"
        }
      },
      "required": [
        "fix_sha256",
        "scope_sha256"
      ],
      "title": "Inputs",
      "type": "object"
    },
    "JsonValue": {},
    "Kev": {
      "additionalProperties": false,
      "description": "One CVE's KEV status in a run: `listed`, `not_listed`, or `unavailable` with the reason.",
      "properties": {
        "entry": {
          "anyOf": [
            {
              "$ref": "#/$defs/KevEntry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "feed": {
          "anyOf": [
            {
              "$ref": "#/$defs/KevFeed"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "enum": [
            "listed",
            "not_listed",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "Kev",
      "type": "object"
    },
    "KevEntry": {
      "additionalProperties": false,
      "description": "The KEV fields fixproof reports for a listed CVE.",
      "properties": {
        "cve": {
          "pattern": "^CVE-[0-9]{4}-[0-9]{4,19}$",
          "title": "Cve",
          "type": "string"
        },
        "date_added": {
          "minLength": 1,
          "title": "Date Added",
          "type": "string"
        },
        "due_date": {
          "minLength": 1,
          "title": "Due Date",
          "type": "string"
        },
        "known_ransomware_campaign_use": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Ransomware Campaign Use"
        },
        "product": {
          "minLength": 1,
          "title": "Product",
          "type": "string"
        },
        "required_action": {
          "minLength": 1,
          "title": "Required Action",
          "type": "string"
        },
        "vendor_project": {
          "minLength": 1,
          "title": "Vendor Project",
          "type": "string"
        },
        "vulnerability_name": {
          "minLength": 1,
          "title": "Vulnerability Name",
          "type": "string"
        }
      },
      "required": [
        "cve",
        "vendor_project",
        "product",
        "vulnerability_name",
        "date_added",
        "due_date",
        "required_action"
      ],
      "title": "KevEntry",
      "type": "object"
    },
    "KevFeed": {
      "additionalProperties": false,
      "description": "The feed a run used.",
      "properties": {
        "catalog_version": {
          "minLength": 1,
          "title": "Catalog Version",
          "type": "string"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "date_released": {
          "minLength": 1,
          "title": "Date Released",
          "type": "string"
        },
        "retrieved": {
          "minLength": 1,
          "title": "Retrieved",
          "type": "string"
        },
        "sha256": {
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "catalog_version",
        "date_released",
        "retrieved",
        "sha256",
        "count"
      ],
      "title": "KevFeed",
      "type": "object"
    },
    "Method": {
      "enum": [
        "grype",
        "sbom_version"
      ],
      "title": "Method",
      "type": "string"
    },
    "MethodResult": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "discriminator": {
            "mapping": {
              "build": "#/$defs/BuildAsset",
              "image": "#/$defs/ImageAsset",
              "workload": "#/$defs/WorkloadAsset"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ImageAsset"
            },
            {
              "$ref": "#/$defs/WorkloadAsset"
            },
            {
              "$ref": "#/$defs/BuildAsset"
            }
          ],
          "title": "Asset"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/Method"
        },
        "raw_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Ref"
        },
        "status": {
          "$ref": "#/$defs/MethodStatus"
        }
      },
      "required": [
        "asset",
        "method",
        "status",
        "detail"
      ],
      "title": "MethodResult",
      "type": "object"
    },
    "MethodStatus": {
      "description": "What one evidence method says about the vulnerable component in one asset.",
      "enum": [
        "present",
        "not_present",
        "error"
      ],
      "title": "MethodStatus",
      "type": "string"
    },
    "NotChecked": {
      "additionalProperties": false,
      "description": "A platform of an image index that fixproof did not check, and why (ADR-0014).",
      "properties": {
        "digest": {
          "minLength": 1,
          "title": "Digest",
          "type": "string"
        },
        "platform": {
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "platform",
        "digest",
        "reason"
      ],
      "title": "NotChecked",
      "type": "object"
    },
    "PlatformRecord": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "description": "The platform's manifest digest the tools read.",
          "title": "Digest",
          "type": "string"
        },
        "platform": {
          "description": "os/architecture[/variant], e.g. linux/arm64.",
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/MethodResult"
          },
          "title": "Results",
          "type": "array"
        },
        "scanned": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "description": "Per method: the image ID, manifest digest and platform the tool scanned.",
          "title": "Scanned",
          "type": "object"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "platform",
        "digest",
        "verdict",
        "reason",
        "results",
        "scanned"
      ],
      "title": "PlatformRecord",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "properties": {
        "fixed": {
          "title": "Fixed",
          "type": "integer"
        },
        "still_affected": {
          "title": "Still Affected",
          "type": "integer"
        },
        "unknown": {
          "title": "Unknown",
          "type": "integer"
        }
      },
      "required": [
        "fixed",
        "still_affected",
        "unknown"
      ],
      "title": "Summary",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "fixed",
        "still_affected",
        "unknown"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "WorkloadAsset": {
      "additionalProperties": false,
      "description": "A container in a running pod. `image` is None when its digest could not be resolved.",
      "properties": {
        "cluster": {
          "minLength": 1,
          "title": "Cluster",
          "type": "string"
        },
        "container": {
          "minLength": 1,
          "title": "Container",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "const": "workload",
          "default": "workload",
          "title": "Kind",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The pod's controller, e.g. Deployment/api (ADR-0010).",
          "title": "Owner"
        },
        "pod": {
          "minLength": 1,
          "title": "Pod",
          "type": "string"
        }
      },
      "required": [
        "cluster",
        "namespace",
        "pod",
        "container",
        "image"
      ],
      "title": "WorkloadAsset",
      "type": "object"
    }
  },
  "$id": "https://github.com/Govardhan527/fixproof/schemas/bundle/2.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/AssetRecord"
      },
      "title": "Assets",
      "type": "array"
    },
    "cve": {
      "pattern": "^CVE-[0-9]{4}-[0-9]{4,19}$",
      "title": "Cve",
      "type": "string"
    },
    "finished": {
      "minLength": 1,
      "title": "Finished",
      "type": "string"
    },
    "fixproof_version": {
      "minLength": 1,
      "title": "Fixproof Version",
      "type": "string"
    },
    "inputs": {
      "$ref": "#/$defs/Inputs"
    },
    "kev": {
      "$ref": "#/$defs/Kev",
      "description": "The CVE's CISA KEV status and the feed used (ADR-0012)."
    },
    "schema_version": {
      "const": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started": {
      "minLength": 1,
      "title": "Started",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "tools": {
      "description": "Each distinct tool and data version used, e.g. Syft and its JSON schema, Grype and its DB schema, build time and source.",
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "type": "object"
      },
      "title": "Tools",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "fixproof_version",
    "started",
    "finished",
    "cve",
    "inputs",
    "tools",
    "summary",
    "kev",
    "assets"
  ],
  "title": "Bundle",
  "type": "object"
}
