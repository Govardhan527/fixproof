{
  "$defs": {
    "GateLine": {
      "additionalProperties": false,
      "properties": {
        "cve": {
          "pattern": "^CVE-[0-9]{4}-[0-9]{4,19}$",
          "title": "Cve",
          "type": "string"
        },
        "kev": {
          "$ref": "#/$defs/Kev"
        },
        "platforms": {
          "default": [],
          "description": "The CVE's verdict on each platform checked.",
          "items": {
            "$ref": "#/$defs/PlatformLine"
          },
          "title": "Platforms",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "cve",
        "verdict",
        "reason",
        "kev"
      ],
      "title": "GateLine",
      "type": "object"
    },
    "GateResult": {
      "additionalProperties": false,
      "description": "`fixproof gate --json` (format `gate-result`, 2.0.0).",
      "properties": {
        "image": {
          "description": "The image as given on the command line.",
          "minLength": 1,
          "title": "Image",
          "type": "string"
        },
        "not_checked": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NotChecked"
          },
          "title": "Not Checked",
          "type": "array"
        },
        "platforms": {
          "description": "What was read, per platform.",
          "items": {
            "$ref": "#/$defs/PlatformRead"
          },
          "title": "Platforms",
          "type": "array"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/GateLine"
          },
          "title": "Results",
          "type": "array"
        },
        "schema_version": {
          "const": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "tools": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "image",
        "platforms",
        "tools",
        "summary",
        "results"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "JsonValue": {},
    "Kev": {
      "additionalProperties": false,
      "description": "One CVE's KEV status in a run: `listed`, `not_listed`, or `unavailable` with the reason.",
      "properties": {
        "entry": {
          "anyOf": [
            {
              "$ref": "#/$defs/KevEntry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "feed": {
          "anyOf": [
            {
              "$ref": "#/$defs/KevFeed"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "enum": [
            "listed",
            "not_listed",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "Kev",
      "type": "object"
    },
    "KevEntry": {
      "additionalProperties": false,
      "description": "The KEV fields fixproof reports for a listed CVE.",
      "properties": {
        "cve": {
          "pattern": "^CVE-[0-9]{4}-[0-9]{4,19}$",
          "title": "Cve",
          "type": "string"
        },
        "date_added": {
          "minLength": 1,
          "title": "Date Added",
          "type": "string"
        },
        "due_date": {
          "minLength": 1,
          "title": "Due Date",
          "type": "string"
        },
        "known_ransomware_campaign_use": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Ransomware Campaign Use"
        },
        "product": {
          "minLength": 1,
          "title": "Product",
          "type": "string"
        },
        "required_action": {
          "minLength": 1,
          "title": "Required Action",
          "type": "string"
        },
        "vendor_project": {
          "minLength": 1,
          "title": "Vendor Project",
          "type": "string"
        },
        "vulnerability_name": {
          "minLength": 1,
          "title": "Vulnerability Name",
          "type": "string"
        }
      },
      "required": [
        "cve",
        "vendor_project",
        "product",
        "vulnerability_name",
        "date_added",
        "due_date",
        "required_action"
      ],
      "title": "KevEntry",
      "type": "object"
    },
    "KevFeed": {
      "additionalProperties": false,
      "description": "The feed a run used.",
      "properties": {
        "catalog_version": {
          "minLength": 1,
          "title": "Catalog Version",
          "type": "string"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "date_released": {
          "minLength": 1,
          "title": "Date Released",
          "type": "string"
        },
        "retrieved": {
          "minLength": 1,
          "title": "Retrieved",
          "type": "string"
        },
        "sha256": {
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "catalog_version",
        "date_released",
        "retrieved",
        "sha256",
        "count"
      ],
      "title": "KevFeed",
      "type": "object"
    },
    "NotChecked": {
      "additionalProperties": false,
      "description": "A platform of an image index that fixproof did not check, and why (ADR-0014).",
      "properties": {
        "digest": {
          "minLength": 1,
          "title": "Digest",
          "type": "string"
        },
        "platform": {
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "platform",
        "digest",
        "reason"
      ],
      "title": "NotChecked",
      "type": "object"
    },
    "PlatformLine": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "platform": {
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "platform",
        "digest",
        "verdict"
      ],
      "title": "PlatformLine",
      "type": "object"
    },
    "PlatformRead": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "platform": {
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "scanned": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "description": "Per tool: the image ID, manifest digest and platform it read.",
          "title": "Scanned",
          "type": "object"
        }
      },
      "required": [
        "platform",
        "digest",
        "scanned"
      ],
      "title": "PlatformRead",
      "type": "object"
    },
    "RawFile": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "platform": {
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        }
      },
      "required": [
        "platform",
        "digest",
        "method",
        "path"
      ],
      "title": "RawFile",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "properties": {
        "fixed": {
          "title": "Fixed",
          "type": "integer"
        },
        "still_affected": {
          "title": "Still Affected",
          "type": "integer"
        },
        "unknown": {
          "title": "Unknown",
          "type": "integer"
        }
      },
      "required": [
        "fixed",
        "still_affected",
        "unknown"
      ],
      "title": "Summary",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "fixed",
        "still_affected",
        "unknown"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "$id": "https://github.com/Govardhan527/fixproof/schemas/gate-bundle/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`gate.json` in `gate --out`: the decision, what it was made from, and its raw files.",
  "properties": {
    "closed_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Closed Sha256",
      "type": "string"
    },
    "finished": {
      "minLength": 1,
      "title": "Finished",
      "type": "string"
    },
    "fixproof_version": {
      "minLength": 1,
      "title": "Fixproof Version",
      "type": "string"
    },
    "raw": {
      "description": "Each tool's sanitised output, per platform.",
      "items": {
        "$ref": "#/$defs/RawFile"
      },
      "title": "Raw",
      "type": "array"
    },
    "result": {
      "$ref": "#/$defs/GateResult"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started": {
      "minLength": 1,
      "title": "Started",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "fixproof_version",
    "started",
    "finished",
    "closed_sha256",
    "raw",
    "result"
  ],
  "title": "GateBundle",
  "type": "object"
}
