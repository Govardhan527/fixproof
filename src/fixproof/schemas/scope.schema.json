{
  "$defs": {
    "Cluster": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "description": "kubeconfig context name",
          "minLength": 1,
          "title": "Context",
          "type": "string"
        },
        "namespaces": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Namespaces",
          "type": "array"
        }
      },
      "required": [
        "context",
        "namespaces"
      ],
      "title": "Cluster",
      "type": "object"
    }
  },
  "$id": "https://github.com/Govardhan527/fixproof/schemas/scope/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`scope.yaml`: what fixproof may look at, and the registries it may read from.",
  "properties": {
    "clusters": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Cluster"
      },
      "title": "Clusters",
      "type": "array"
    },
    "images": {
      "default": [],
      "items": {
        "description": "registry/repository@sha256:<64 hex>, registry host required",
        "type": "string"
      },
      "title": "Images",
      "type": "array"
    },
    "registries": {
      "items": {
        "pattern": "^([a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9-]*[a-zA-Z0-9])(\\.([a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9-]*[a-zA-Z0-9]))*(:[0-9]+)?$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Registries",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "registries"
  ],
  "title": "ScopeFile",
  "type": "object"
}
